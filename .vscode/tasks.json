{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Media Downloader",
      "type": "process",
      "command": "${workspaceFolder}\\start.bat",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "${workspaceFolder}\\run-tests.bat",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Update yt-dlp",
      "type": "process",
      "command": "${workspaceFolder}\\update.bat",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/

# App data (downloaded files, logs, caches, portable tools)
downloads/*
!downloads/.gitkeep
logs/*
!logs/.gitkeep
.cache/
tools/

# Media and partial downloads anywhere in the tree
*.mp4
*.mp3
*.webm
*.m4a
*.part
*.ytdl

# Secrets and local configuration - never commit these
.env
.env.*
!.env.example
*.cookies
cookies*.txt
*.pem
*.key
.claude/settings.local.json

# Editors / OS
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
